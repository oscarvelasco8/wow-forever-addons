{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/wow-forever-addons/browser",
  "functions": {
    "api/render.ts": {
      "includeFiles": "dist/wow-forever-addons/{server,browser}/**",
      "maxDuration": 30
    },
    "api/image.ts": {
      "maxDuration": 20
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/administracion(?:/.*)?",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/addons/([^/]+)",
      "dest": "/api/render?slug=$1"
    },
    {
      "src": "/administracion(?:/categorias|/verificar|/restablecer|/addons/[^/]+(?:/archivos|/publicacion)?)?/?",
      "dest": "/index.csr.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
