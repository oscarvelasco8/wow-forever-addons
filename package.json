{
  "name": "wow-forever-addons",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env node_modules/@angular/cli/bin/ng.js serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "start:built": "node --env-file-if-exists=.env scripts/serve-built.mjs",
    "start:api": "node --watch --env-file-if-exists=.env server/dev.ts",
    "build": "ng build && node scripts/finalize-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:api": "node --test tests/api/*.test.ts",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:ssr": "node --test tests/ssr/*.test.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "verify:supabase": "node --env-file=.env scripts/verify-supabase.ts",
    "verify:storage": "node --env-file=.env scripts/verify-storage.ts",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck:api && npm run test:api && npm run test:db && npm test && npm run build && npm run test:ssr && npm run test:packaging"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "2.119.1",
    "fflate": "0.8.3",
    "rxjs": "~7.8.0",
    "sharp": "0.35.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
