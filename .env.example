# Local backend only. Frontend public configuration will have an explicit allowlist.
API_PORT=3001
# Canonical origin, set once a public domain is confirmed. Missing keeps SEO noindex.
PUBLIC_SITE_URL=
# Supabase: configure only after creating the development project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional privileged key, backend only. Not required by this phase or its tests.
SUPABASE_SECRET_KEY=
# Checkout test only; live keys are rejected. Leave disabled until sandbox review.
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_SECRET_KEY=
# Random 32-byte hex signing key for private, read-only receipt capabilities.
SUPPORT_RECEIPT_SECRET=
STRIPE_TEST_SITE_URL=http://localhost:4200
# Webhook remains disabled until private ledger migration and sandbox are verified.
STRIPE_TEST_WEBHOOK_ENABLED=false
STRIPE_TEST_WEBHOOK_SECRET=
# Dedicated server-only Supabase secret; also required by the shared checkout quota.
# Checkout needs configured webhook + ledger credentials; no local-memory fallback.
SUPABASE_WEBHOOK_SECRET_KEY=
# Never put backend secrets in src/, public/ or Angular environment files.
